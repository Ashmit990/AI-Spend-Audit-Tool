# -----------------------------------------------------------------
# AI Spend Audit Tool — Environment Variables
# -----------------------------------------------------------------
# Copy this file to `.env.local` and fill in your real keys.
# All variables are optional — the app degrades gracefully without them.
# -----------------------------------------------------------------

# ─── Supabase ────────────────────────────────────────────────────
# Get these from: https://supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Anthropic (Claude API) ─────────────────────────────────────
# Get this from: https://console.anthropic.com → API Keys
# Used for AI-generated audit summaries. Falls back to a static summary.
ANTHROPIC_API_KEY=sk-ant-your-api-key

# ─── Resend (Transactional Email) ───────────────────────────────
# Get this from: https://resend.com → API Keys
# Used to send audit report emails. Skipped if not configured.
RESEND_API_KEY=re_your-api-key

# ─── App URL ─────────────────────────────────────────────────────
# The public URL of your deployed app (used in email links).
# Defaults to http://localhost:3000 in development.
NEXT_PUBLIC_APP_URL=http://localhost:3000
